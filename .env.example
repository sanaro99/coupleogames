# Server-only values. Never prefix personal values with VITE_.
# Private room invitations are created by the operator CLI, never environment keys.
APP_ORIGIN=http://localhost:5173
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/coupleogames.sqlite
MAX_ROOMS=100
MAX_SESSIONS_PER_SEAT=5
MAX_SOCKETS_PER_SESSION=3
# Exact immediate proxy IPs only; blank means ignore forwarded client addresses.
TRUSTED_PROXY_ADDRESSES=
# Source Compose examples require an approved immutable image; launch remains held.
COUPLEOGAMES_IMAGE=
# Production: NODE_ENV=production, APP_ORIGIN=https://your-domain, PORT=3001, HOST=0.0.0.0
